# Copy to .env and fill in. Blank = that provider is skipped.

# Meta Model API — https://dev.meta.ai → API keys. Format: LLM|<numeric_id>|<secret>
# Covers Muse Spark, Muse Wonder, Muse Image, Muse Voice Transcribe, SAM 3.1.
MODEL_API_KEY=

# Baseten — app.baseten.co → Settings → API Keys. Serves Muse Spark Open.
BASETEN_API_KEY=

# Fireworks — fireworks.ai → API keys (fw_...). Serves Muse Spark Open.
FIREWORKS_API_KEY=

# Modal proxy token, joined as <token-id>.<token-secret> (wk-....ws-...).
#   uv run modal workspace proxy-tokens create
# Used for the Muse Spark Open shared endpoint and our self-hosted Glimmer server.
MODAL_PROXY_TOKEN=
# Modal dashboard → Endpoints → Muse Spark Open (Shared): copy the URL and model name.
MODAL_SPARK_OPEN_URL=
MODAL_SPARK_OPEN_MODEL=
# Printed by `uv run modal deploy modal_apps/glimmer.py`
GLIMMER_URL=

# SAM 3D Objects runs on Modal and authenticates with your local Modal CLI login
# (`uv run modal token new`), not with a key in this file. Its Hugging Face token
# lives in a Modal secret; see modal_apps/sam3d.py.

# Hugging Face token with access to facebook/sam-3d-objects (only for the SAM 3D fallback)
HF_TOKEN=
